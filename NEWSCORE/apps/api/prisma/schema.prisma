generator client { provider = "prisma-client-js" }

datasource db { provider = "postgresql" url = env("DATABASE_URL") extensions = [postgis] }

enum UserStatus { ACTIVE INACTIVE SUSPENDED }
enum ArticleStatus { DRAFT SUBMITTED IN_REVIEW FACT_CHECK COPY_EDIT APPROVED SCHEDULED PUBLISHED UPDATED CORRECTED ARCHIVED }
enum Priority { LOW NORMAL HIGH URGENT }
enum AssignmentStatus { CREATED ACCEPTED REJECTED IN_PROGRESS PAUSED SUBMITTED COMPLETED }
enum ReviewStatus { PENDING APPROVED REJECTED CHANGES_REQUESTED }
enum ClaimStatus { UNCHECKED IN_REVIEW VERIFIED NEEDS_MORE_EVIDENCE DISPUTED REJECTED NOT_APPLICABLE }
enum MediaType { PHOTO VIDEO AUDIO DOCUMENT INFOGRAPHIC GRAPHIC }
enum JobStatus { QUEUED RUNNING SUCCEEDED FAILED DEAD }

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  displayName String
  bio String?
  avatarUrl String?
  locale String @default("fa")
  timezone String @default("Asia/Tehran")
  status UserStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  roles UserRole[]
  sessions Session[]
  articles ArticleAuthor[]
  assignments Assignment[] @relation("Assignee")
  createdAssignments Assignment[] @relation("AssignmentCreator")
  pitches Pitch[]
  reviews EditorialReview[]
  factChecks FactCheck[]
  comments Comment[]
  notifications Notification[]
  auditLogs AuditLog[]
  sourceRecords SourceRecord[]
  revisions ArticleRevision[]
  availability AvailabilityRule[]
  editedDesks Desk[] @relation("DeskEditor")
  subscriptions Subscription[]
  researchNotes ResearchNote[]
  attachments Attachment[]
  newsletterItems NewsletterItem[]
}

model Role {
  id String @id @default(cuid())
  name String @unique
  description String?
  users UserRole[]
  permissions RolePermission[]
}

model Permission {
  id String @id @default(cuid())
  key String @unique
  description String?
  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())
  @@id([userId, roleId])
}

model RolePermission {
  roleId String
  permissionId String
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model Session {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  device String?
  ipAddress String?
  userAgent String?
  lastSeenAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, revokedAt])
}

model Team { id String @id @default(cuid()); name String @unique; desks Desk[]; createdAt DateTime @default(now()) }
model Desk {
  id String @id @default(cuid())
  name String @unique
  slug String @unique
  editorId String?
  teamId String?
  editor User? @relation("DeskEditor", fields: [editorId], references: [id])
  team Team? @relation(fields: [teamId], references: [id])
  sections Section[]
  assignments Assignment[]
  workflowRules Json?
  publishingRules Json?
  notificationChannel Json?
}
model Section {
  id String @id @default(cuid())
  name String
  slug String @unique
  deskId String?
  parentId String?
  desk Desk? @relation(fields: [deskId], references: [id])
  parent Section? @relation("SectionTree", fields: [parentId], references: [id])
  children Section[] @relation("SectionTree")
  categories Category[]
  articles Article[]
  @@index([deskId])
}
model Category { id String @id @default(cuid()); name String; slug String @unique; sectionId String?; section Section? @relation(fields:[sectionId], references:[id]); parentId String?; parent Category? @relation("CategoryTree", fields:[parentId], references:[id]); children Category[] @relation("CategoryTree") }
model Tag { id String @id @default(cuid()); name String @unique; slug String @unique; articles ArticleTag[] }
model Topic { id String @id @default(cuid()); name String; slug String @unique; description String?; articles ArticleTopic[]; entities EntityTopic[] }
model EntityTopic { entityId String; topicId String; entity Entity @relation(fields:[entityId], references:[id], onDelete: Cascade); topic Topic @relation(fields:[topicId], references:[id], onDelete: Cascade); @@id([entityId,topicId]); }
model Location { id String @id @default(cuid()); name String; slug String @unique; latitude Float?; longitude Float?; geoJson Json?; articles Article[]; events Event[] }
model Entity { id String @id @default(cuid()); type String; name String; slug String @unique; aliases String[]; metadata Json?; articles ArticleEntity[]; topics EntityTopic[]; relationships GraphRelationship[] @relation("FromEntity"); relatedFrom GraphRelationship[] @relation("ToEntity") }
model Event { id String @id @default(cuid()); name String; startsAt DateTime?; endsAt DateTime?; locationId String?; location Location? @relation(fields:[locationId], references:[id]); articles ArticleEvent[] }

model Story { id String @id @default(cuid()); title String; slug String @unique; summary String?; storyType String @default("story"); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; articles Article[] }
model Article {
  id String @id @default(cuid())
  storyId String
  title String
  slug String @unique
  subtitle String?
  summary String?
  lead String?
  body Json
  status ArticleStatus @default(DRAFT)
  priority Priority @default(NORMAL)
  language String @default("fa")
  publishedAt DateTime?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  readingTime Int @default(1)
  seo Json?
  social Json?
  correctionState String?
  coverAssetId String?
  sectionId String?
  categoryId String?
  locationId String?
  story Story @relation(fields:[storyId], references:[id], onDelete: Cascade)
  section Section? @relation(fields:[sectionId], references:[id])
  category Category? @relation(fields:[categoryId], references:[id])
  location Location? @relation(fields:[locationId], references:[id])
  coverAsset MediaAsset? @relation("ArticleCover", fields:[coverAssetId], references:[id])
  authors ArticleAuthor[]
  tags ArticleTag[]
  topics ArticleTopic[]
  sources ArticleSource[]
  revisions ArticleRevision[]
  blocks ArticleBlock[]
  claims ArticleClaim[]
  corrections Correction[]
  schedules PublicationSchedule[]
  comments Comment[]
  relations StoryRelationship[] @relation("SourceArticle")
  relatedTo StoryRelationship[] @relation("TargetArticle")
  entities ArticleEntity[]
  events ArticleEvent[]
  media MediaUsage[]
  analytics AnalyticsEvent[]
  @@index([status, priority, publishedAt])
  @@index([sectionId, status, publishedAt])
  @@index([language, publishedAt])
}
model ArticleAuthor { articleId String; userId String; isPrimary Boolean @default(false); article Article @relation(fields:[articleId], references:[id], onDelete: Cascade); user User @relation(fields:[userId], references:[id]); @@id([articleId,userId]); }
model ArticleTag { articleId String; tagId String; article Article @relation(fields:[articleId], references:[id], onDelete: Cascade); tag Tag @relation(fields:[tagId], references:[id], onDelete: Cascade); @@id([articleId,tagId]); }
model ArticleTopic { articleId String; topicId String; article Article @relation(fields:[articleId], references:[id], onDelete: Cascade); topic Topic @relation(fields:[topicId], references:[id], onDelete: Cascade); @@id([articleId,topicId]); }
model ArticleEntity { articleId String; entityId String; relationType String @default("mentioned_in"); article Article @relation(fields:[articleId], references:[id], onDelete: Cascade); entity Entity @relation(fields:[entityId], references:[id], onDelete: Cascade); @@id([articleId,entityId,relationType]); }
model ArticleEvent { articleId String; eventId String; article Article @relation(fields:[articleId], references:[id], onDelete: Cascade); event Event @relation(fields:[eventId], references:[id], onDelete: Cascade); @@id([articleId,eventId]); }
model ArticleSource { articleId String; sourceId String; article Article @relation(fields:[articleId], references:[id], onDelete: Cascade); source SourceRecord @relation(fields:[sourceId], references:[id]); @@id([articleId,sourceId]); }
model ArticleBlock { id String @id @default(cuid()); articleId String; position Int; type String; data Json; article Article @relation(fields:[articleId], references:[id], onDelete: Cascade); @@index([articleId,position]); }
model ArticleRevision { id String @id @default(cuid()); articleId String; version Int; snapshot Json; diff Json?; editorId String; reason String?; createdAt DateTime @default(now()); article Article @relation(fields:[articleId], references:[id], onDelete: Cascade); editor User @relation(fields:[editorId], references:[id]); @@unique([articleId,version]); }
model ArticleClaim { id String @id @default(cuid()); articleId String; text String; status ClaimStatus @default(UNCHECKED); article Article @relation(fields:[articleId], references:[id], onDelete: Cascade); factChecks FactCheck[]; @@index([articleId,status]); }
model FactCheck { id String @id @default(cuid()); claimId String; reviewerId String; status ClaimStatus; evidence Json; notes String?; reviewedAt DateTime?; claim ArticleClaim @relation(fields:[claimId], references:[id], onDelete: Cascade); reviewer User @relation(fields:[reviewerId], references:[id]); }
model Correction { id String @id @default(cuid()); articleId String; originalVersion Int; correctedVersion Int; note String; approvedById String; approvedAt DateTime @default(now()); article Article @relation(fields:[articleId], references:[id], onDelete: Cascade); approvedBy User @relation(fields:[approvedById], references:[id]); }
model EditorialReview { id String @id @default(cuid()); articleId String; reviewerId String; status ReviewStatus @default(PENDING); notes String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; article Article @relation(fields:[articleId], references:[id], onDelete: Cascade); reviewer User @relation(fields:[reviewerId], references:[id]); @@index([articleId,status]); }
model PublicationSchedule { id String @id @default(cuid()); articleId String; publishAt DateTime; timezone String; embargoUntil DateTime?; executedAt DateTime?; cancelledAt DateTime?; article Article @relation(fields:[articleId], references:[id], onDelete: Cascade); @@index([publishAt,executedAt,cancelledAt]); }

model Assignment {
  id String @id @default(cuid())
  title String
  description String?
  deskId String?
  sectionId String?
  assigneeId String
  creatorId String
  deadline DateTime
  expectedPublishAt DateTime?
  priority Priority @default(NORMAL)
  status AssignmentStatus @default(CREATED)
  locationId String?
  requiredMedia Json?
  sourceSuggestions Json?
  reviewerId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  desk Desk? @relation(fields:[deskId], references:[id])
  section Section? @relation(fields:[sectionId], references:[id])
  assignee User @relation("Assignee", fields:[assigneeId], references:[id])
  creator User @relation("AssignmentCreator", fields:[creatorId], references:[id])
  activity Activity[]
  @@index([assigneeId,status,deadline])
  @@index([deskId,status,deadline])
}
model Pitch { id String @id @default(cuid()); reporterId String; title String; idea String; status String @default("PENDING"); editorNotes String?; convertedAssignmentId String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; reporter User @relation(fields:[reporterId], references:[id]); }
model Activity { id String @id @default(cuid()); assignmentId String?; articleId String?; actorId String; type String; data Json?; createdAt DateTime @default(now()); assignment Assignment? @relation(fields:[assignmentId], references:[id], onDelete: Cascade); actor User @relation(fields:[actorId], references:[id]); }

model BreakingNews { id String @id @default(cuid()); headline String; summary String?; sourceId String?; severity Priority @default(HIGH); status String @default("ACTIVE"); timeline Json; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; }
model LiveBlog { id String @id @default(cuid()); title String; slug String @unique; status String @default("DRAFT"); autoRefreshSeconds Int @default(10); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; updates LiveBlogUpdate[] }
model LiveBlogUpdate { id String @id @default(cuid()); liveBlogId String; authorId String; text String; data Json?; publishedAt DateTime?; pinned Boolean @default(false); highlight Boolean @default(false); createdAt DateTime @default(now()); liveBlog LiveBlog @relation(fields:[liveBlogId], references:[id], onDelete: Cascade); author User @relation(fields:[authorId], references:[id]); @@index([liveBlogId,createdAt]); }

model MediaAsset { id String @id @default(cuid()); type MediaType; key String @unique; filename String; mimeType String; size Int; metadata Json?; altText String?; caption String?; credit String?; rights Json?; processingState String @default("PENDING"); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; versions MediaVersion[]; usage MediaUsage[]; coverArticles Article[] @relation("ArticleCover"); }
model MediaVersion { id String @id @default(cuid()); assetId String; key String; width Int?; height Int?; duration Int?; metadata Json?; createdAt DateTime @default(now()); asset MediaAsset @relation(fields:[assetId], references:[id], onDelete: Cascade); }
model MediaUsage { id String @id @default(cuid()); articleId String; assetId String; role String @default("inline"); article Article @relation(fields:[articleId], references:[id], onDelete: Cascade); asset MediaAsset @relation(fields:[assetId], references:[id]); }
model MediaRight { id String @id @default(cuid()); assetId String; license String?; expiresAt DateTime?; allowedUsage String[]; territory String?; credit String?; asset MediaAsset @relation(fields:[assetId], references:[id], onDelete: Cascade); @@index([expiresAt]); }
model SourceRecord { id String @id @default(cuid()); name String; type String; contactMetadata Json?; reliabilityNote String?; accessScope String @default("internal"); language String?; location String?; tags String[]; ownerId String?; owner User? @relation(fields:[ownerId], references:[id]); usageHistory Json?; createdAt DateTime @default(now()); }

model Comment { id String @id @default(cuid()); articleId String; userId String; parentId String?; body String; status String @default("PENDING"); reportCount Int @default(0); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; article Article @relation(fields:[articleId], references:[id], onDelete: Cascade); user User @relation(fields:[userId], references:[id]); parent Comment? @relation("CommentTree", fields:[parentId], references:[id]); replies Comment[] @relation("CommentTree"); }
model Notification { id String @id @default(cuid()); userId String; type String; title String; body String; data Json?; readAt DateTime?; snoozedUntil DateTime?; createdAt DateTime @default(now()); user User @relation(fields:[userId], references:[id], onDelete: Cascade); @@index([userId,readAt,createdAt]); }
model NotificationPreference { id String @id @default(cuid()); userId String; channel String; eventType String; enabled Boolean @default(true); user User @relation(fields:[userId], references:[id], onDelete: Cascade); @@unique([userId,channel,eventType]); }
model SavedStory { id String @id @default(cuid()); userId String; articleId String; collection String @default("default"); createdAt DateTime @default(now()); user User @relation(fields:[userId], references:[id], onDelete: Cascade); article Article @relation(fields:[articleId], references:[id], onDelete: Cascade); @@unique([userId,articleId,collection]); }
model ReadingHistory { id String @id @default(cuid()); userId String; articleId String; readAt DateTime @default(now()); seconds Int @default(0); user User @relation(fields:[userId], references:[id], onDelete: Cascade); article Article @relation(fields:[articleId], references:[id], onDelete: Cascade); }
model SavedSearch { id String @id @default(cuid()); userId String; name String; query Json; createdAt DateTime @default(now()); user User @relation(fields:[userId], references:[id], onDelete: Cascade); }
model SearchEvent { id String @id @default(cuid()); query String; userId String?; filters Json?; resultCount Int @default(0); latencyMs Int @default(0); createdAt DateTime @default(now()); }
model AnalyticsEvent { id String @id @default(cuid()); name String; articleId String?; userId String?; sessionId String?; properties Json?; occurredAt DateTime @default(now()); article Article? @relation(fields:[articleId], references:[id]); @@index([name,occurredAt]); @@index([articleId,occurredAt]); }

model NewsletterCampaign { id String @id @default(cuid()); name String; subject String; previewText String?; language String; template Json; audience Json; scheduledAt DateTime?; status String @default("DRAFT"); items NewsletterItem[] }
model NewsletterItem { id String @id @default(cuid()); campaignId String; articleId String; position Int; campaign NewsletterCampaign @relation(fields:[campaignId], references:[id], onDelete: Cascade); article Article @relation(fields:[articleId], references:[id]); @@index([campaignId,position]); }
model Subscription { id String @id @default(cuid()); userId String; planId String; status String; providerCustomerId String?; expiresAt DateTime?; createdAt DateTime @default(now()); user User @relation(fields:[userId], references:[id], onDelete: Cascade); plan SubscriptionPlan @relation(fields:[planId], references:[id]); entitlements SubscriptionEntitlement[]; }
model SubscriptionPlan { id String @id @default(cuid()); name String @unique; priceCents Int; currency String @default("USD"); metered Boolean @default(false); rules Json?; subscriptions Subscription[] }
model SubscriptionEntitlement { id String @id @default(cuid()); subscriptionId String; key String; value String; subscription Subscription @relation(fields:[subscriptionId], references:[id], onDelete: Cascade); }
model AdCampaign { id String @id @default(cuid()); name String; status String; startAt DateTime; endAt DateTime; targetContext Json?; frequencyCap Int?; advertisements Advertisement[] }
model AdSlot { id String @id @default(cuid()); name String @unique; placement String; device String @default("all"); active Boolean @default(true); advertisements Advertisement[] }
model Advertisement { id String @id @default(cuid()); campaignId String; slotId String; creative Json; impressionMetadata Json?; campaign AdCampaign @relation(fields:[campaignId], references:[id], onDelete: Cascade); slot AdSlot @relation(fields:[slotId], references:[id]); }

model AuditLog { id String @id @default(cuid()); actorId String?; action String; entityType String; entityId String?; ipAddress String?; requestId String?; traceId String?; metadata Json?; createdAt DateTime @default(now()); actor User? @relation(fields:[actorId], references:[id]); @@index([entityType,entityId,createdAt]); @@index([action,createdAt]); }
model Webhook { id String @id @default(cuid()); name String; url String; secretHash String; enabled Boolean @default(true); events String[]; deliveries WebhookDelivery[]; createdAt DateTime @default(now()); }
model WebhookDelivery { id String @id @default(cuid()); webhookId String; eventType String; payload Json; statusCode Int?; attempts Int @default(0); response Json?; nextAttemptAt DateTime?; deliveredAt DateTime?; createdAt DateTime @default(now()); webhook Webhook @relation(fields:[webhookId], references:[id], onDelete: Cascade); @@index([nextAttemptAt,deliveredAt]); }
model ApiKey { id String @id @default(cuid()); name String; keyHash String @unique; scopes String[]; expiresAt DateTime?; revokedAt DateTime?; createdAt DateTime @default(now()); }
model FeatureFlag { id String @id @default(cuid()); key String @unique; enabled Boolean @default(false); rules Json?; version Int @default(1); updatedAt DateTime @updatedAt; }
model Translation { id String @id @default(cuid()); entityType String; entityId String; locale String; fields Json; version Int @default(1); published Boolean @default(false); @@unique([entityType,entityId,locale,version]); }
model ContentTemplate { id String @id @default(cuid()); name String @unique; contentType String; blocks Json; workflow Json; published Boolean @default(true); }
model EditorialPolicy { id String @id @default(cuid()); name String @unique; version Int @default(1); rules Json; active Boolean @default(true); }
model EditorialChecklist { id String @id @default(cuid()); name String @unique; contentType String; items Json; active Boolean @default(true); }
model SpecialCoverage { id String @id @default(cuid()); name String; slug String @unique; summary String?; status String @default("DRAFT"); items CoverageItem[]; createdAt DateTime @default(now()); }
model CoverageItem { id String @id @default(cuid()); coverageId String; type String; refId String; position Int; coverage SpecialCoverage @relation(fields:[coverageId], references:[id], onDelete: Cascade); @@index([coverageId,position]); }
model NewsTip { id String @id @default(cuid()); senderName String?; senderEmail String?; message String; attachmentKeys String[]; status String @default("NEW"); createdAt DateTime @default(now()); }
model PressRelease { id String @id @default(cuid()); sender String; title String; content String; attachments String[]; status String @default("INTAKE"); createdAt DateTime @default(now()); }
model Interview { id String @id @default(cuid()); title String; participants Json; questions Json; answers Json; notes String?; audioAssetId String?; transcriptId String?; status String @default("DRAFT"); createdAt DateTime @default(now()); }
model Transcript { id String @id @default(cuid()); mediaAssetId String; language String; body String; source Json?; revision Int @default(1); createdAt DateTime @default(now()); }
model ResearchNote { id String @id @default(cuid()); ownerId String; title String; content String; evidence Json?; linkedArticleId String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; owner User @relation(fields:[ownerId], references:[id]); }
model Attachment { id String @id @default(cuid()); ownerId String?; owner User? @relation(fields:[ownerId], references:[id]); key String @unique; filename String; mimeType String; size Int; metadata Json?; createdAt DateTime @default(now()); }
model AvailabilityRule { id String @id @default(cuid()); userId String; day Int; open String; close String; enabled Boolean @default(true); user User @relation(fields:[userId], references:[id], onDelete: Cascade); @@unique([userId,day]); }
model Job { id String @id @default(cuid()); type String; payload Json; status JobStatus @default(QUEUED); attempts Int @default(0); availableAt DateTime @default(now()); createdAt DateTime @default(now()); runs JobRun[]; @@index([type,status,availableAt]); }
model JobRun { id String @id @default(cuid()); jobId String; startedAt DateTime @default(now()); endedAt DateTime?; status JobStatus; error String?; job Job @relation(fields:[jobId], references:[id], onDelete: Cascade); }
model StoryRelationship { id String @id @default(cuid()); sourceArticleId String; targetArticleId String; relationType String; strength Float @default(0); createdAt DateTime @default(now()); source Article @relation("SourceArticle", fields:[sourceArticleId], references:[id], onDelete: Cascade); target Article @relation("TargetArticle", fields:[targetArticleId], references:[id], onDelete: Cascade); @@unique([sourceArticleId,targetArticleId,relationType]); }
model GraphRelationship { id String @id @default(cuid()); fromEntityId String; toEntityId String; relationType String; validFrom DateTime @default(now()); validTo DateTime?; metadata Json?; fromEntity Entity @relation("FromEntity", fields:[fromEntityId], references:[id], onDelete: Cascade); toEntity Entity @relation("ToEntity", fields:[toEntityId], references:[id], onDelete: Cascade); @@index([fromEntityId,relationType,validFrom]); }
